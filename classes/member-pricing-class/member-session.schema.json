{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "com.clodhub/member-session",
  "x-version": "1.0.0",
  "description": "A sign-up session as kept in the records collection memberSessions; the store removes it sessionMinutes after createdAt. It is written as a records export line's document: each date is {\"$date\": ISO 8601 text}.",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "pending_email",
        "pending_approval",
        "approved"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/date"
    },
    "updatedAt": {
      "$ref": "#/$defs/date"
    }
  },
  "required": [
    "_id",
    "sessionId",
    "planId",
    "state",
    "name",
    "email",
    "language",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  },
  "x-clodhub-modules": {}
}
